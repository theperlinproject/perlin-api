const ApiVersion: u32 = 1 @doc("Major generation of the wire contract (the wasm import module is `perlin`); a breaking redesign would be 2, served next to 1");
const ApiRevision: u32 = 1 @doc("Revision of this schema: it grows with every addition and must equal the `api perlin version` line");
const ApiOldestRevision: u32 = 1 @doc("Oldest revision hosts still serve; plugins built for it keep working");
const NeedMoreBase: i32 = 16 @doc("perlin.call results below -NeedMoreBase mean the output buffer was too small: -(NeedMoreBase + needed)");
const EventCancel: u32 = 1 @doc("Bit 0 of a perlin_event result cancels the event");
const GfxIndex32: u32 = 1;
const GfxMaxBytes: u32 = 8388608;
const GfxMaxVertices: u32 = 1048576;
const GfxMaxLayers: u32 = 8;
const GfxScreenZ: i32 = 100;
const GfxMaxTextures: u32 = 64;
const GfxMaxTextureSide: u32 = 4096;
const GfxMaxTextureBytes: u64 = 134217728;
const SocketMaxOpen: u32 = 8 @doc("Open sockets per plugin");
const SocketMaxMessage: u32 = 4194304 @doc("Largest single send or received message in bytes");
const AudioStreamMax: u32 = 16 @doc("Open audio streams per plugin");

enum Status: i32 @doc("Result of every call; negative values are returned by perlin.call") {
    Ok = 0;
    UnknownOp = -1 @doc("The running host does not provide the operation");
    Denied = -2 @doc("The plugin lacks a permission the operation needs");
    BadArguments = -3;
    Unavailable = -4 @doc("Not possible right now, for example not connected");
    NotFound = -5;
    Failed = -6;
}

flags Permission: u32 @doc("Capabilities a plugin manifest requests") {
    Network = 0;
    Packets = 1;
    Control = 2;
    Storage = 3;
    Files = 4;
    Native = 5;
    World = 6 @doc("Server: change blocks, entities and the world");
    Players = 7 @doc("Server: change players, their inventories and stats");
    Admin = 8 @doc("Server: run commands, kick and ban, change game rules");
    Microphone = 9 @doc("Client: record from the microphone");
    Clipboard = 10 @doc("Client: read the system clipboard");
    Window = 11 @doc("Client: change the game window");
    Sockets = 12 @doc("Open raw TCP and WebSocket connections");
    Gpu = 13 @doc("Client: run shaders and draw with the game's graphics device");
}

alias Permissions = flagset<Permission>;

enum Draw: u8 { Rect = 1; Text = 2; Item = 3; Image = 4; Line = 5; Gradient = 6; Border = 7; }

enum Screen: i32 {
    None = 0; Pause = 1; Chat = 2; Inventory = 3; Options = 4; Mods = 5; Wardrobe = 6; Death = 7;
    Workbench = 8; Menu = 9; Other = 10; Custom = 11;
}

enum HudElement: i32 {
    Hearts = 0; Armor = 1; Hunger = 2; Air = 3; Hotbar = 4; Experience = 5; Debug = 6; Chat = 7;
    Effects = 8; Locator = 9; Fire = 10; Subtitles = 11; Crosshair = 12;
}

enum InteractKind: i32 { StartBreak = 0; Attack = 1; InteractEntity = 2; UseOnBlock = 3; UseItem = 4; }

enum RenderStage: i32 { AfterTerrain = 0; AfterEntities = 1; Overlay = 2; }

enum KeyContext: i32 { InGame = 0; InScreen = 1; Any = 2; }

enum GameMode: i32 {
    Survival = 0; Creative = 1; Adventure = 2; SurvivalSpectator = 3; CreativeSpectator = 4; Default = 5;
    Spectator = 6;
}

enum Dimension: i32 { Overworld = 0; Nether = 1; End = 2; }

enum Difficulty: i32 { Peaceful = 0; Easy = 1; Normal = 2; Hard = 3; }

enum PermissionLevel: i32 { Unknown = -1; Visitor = 0; Member = 1; Operator = 2; Custom = 3; }

enum Face: i32 { Down = 0; Up = 1; North = 2; South = 3; West = 4; East = 5; }

enum AimKind: i32 { None = 0; Block = 1; Entity = 2; }

enum ChatType: i32 {
    Raw = 0; Chat = 1; Translation = 2; Popup = 3; JukeboxPopup = 4; Tip = 5; System = 6; Whisper = 7;
    Announcement = 8; ObjectWhisper = 9; Object = 10; ObjectAnnouncement = 11;
}

enum DisconnectReason: i32 {
    Unknown = 0; CantConnectNoInternet = 1; NoPermissions = 2; UnrecoverableError = 3; ThirdPartyBlocked = 4;
    ThirdPartyNoInternet = 5; ThirdPartyBadIp = 6; ThirdPartyNoServerOrServerLocked = 7; VersionMismatch = 8;
    SkinIssue = 9; InviteSessionNotFound = 10;
}

enum EffectId: i32 @range(1, 63) {
    Speed = 1; Slowness = 2; Haste = 3; MiningFatigue = 4; Strength = 5; InstantHealth = 6; InstantDamage = 7;
    JumpBoost = 8; Nausea = 9; Regeneration = 10; Resistance = 11; FireResistance = 12; WaterBreathing = 13;
    Invisibility = 14; Blindness = 15; NightVision = 16; Hunger = 17; Weakness = 18; Poison = 19; Wither = 20;
    HealthBoost = 21; Absorption = 22; Saturation = 23; Levitation = 24; FatalPoison = 25; ConduitPower = 26;
    SlowFalling = 27; BadOmen = 28; VillageHero = 29; Darkness = 30; TrialOmen = 31; RaidOmen = 32;
    WindCharged = 33; Weaving = 34; Oozing = 35; Infested = 36;
}

enum Perspective: i32 { FirstPerson = 0; ThirdPersonBack = 1; ThirdPersonFront = 2; }

enum SettingKind: u8 { Toggle = 0; Integer = 1; Number = 2; Choice = 3; Button = 4; Label = 5; Header = 6; }

enum Area: u8 { Mod = 0; Screenshots = 1; ResourcePacks = 2; ShaderPacks = 3; }

enum EntityFlag: u8 @range(0, 63) {
    OnFire = 0; Sneaking = 1; Riding = 2; Sprinting = 3; UsingItem = 4; Invisible = 5; Tempted = 6; InLove = 7;
    Saddled = 8; Powered = 9; Ignited = 10; Baby = 11; Converting = 12; Critical = 13; CanShowName = 14;
    AlwaysShowName = 15; NoAi = 16; Silent = 17; WallClimbing = 18; CanClimb = 19; CanSwim = 20; CanFly = 21;
    CanWalk = 22; Resting = 23; Sitting = 24; Angry = 25; Interested = 26; Charged = 27; Tamed = 28;
    Orphaned = 29; Leashed = 30; Sheared = 31; Gliding = 32; Elder = 33; Moving = 34; Breathing = 35;
    Chested = 36; Stackable = 37; ShowBase = 38; Rearing = 39; Vibrating = 40; Idling = 41; EvokerSpell = 42;
    ChargeAttack = 43; WasdControlled = 44; CanPowerJump = 45; Lingering = 46; HasCollision = 47;
    HasGravity = 48; FireImmune = 49; Dancing = 50; Enchanted = 51; ReturnTrident = 52; ContainerPrivate = 53;
    Transforming = 54; DamageNearbyMobs = 55; Swimming = 56; Bribed = 57; Pregnant = 58; LayingEgg = 59;
    PassengerCanPick = 60; TransitionSitting = 61; Eating = 62; LayingDown = 63;
}

alias EntityFlags = indexset<EntityFlag, u64>;

enum Tool: u8 { None = 0; Pickaxe = 1; Axe = 2; Shovel = 3; Hoe = 4; Shears = 5; Sword = 6; }

enum NameKind: u8 { Item = 0; Block = 1; Entity = 2; }

enum DamageCause: i32 @doc("Why a player or mob took damage") {
    Generic = 0; Mob = 1; Player = 2; Projectile = 3; Explosion = 4; Fall = 5; Void = 6; Lava = 7; Fire = 8;
    Burning = 9; Drowning = 10; Starving = 11; Suffocation = 12; Cactus = 13; Magma = 14; BerryBush = 15;
    Poison = 16; Wither = 17; Magic = 18; FallingBlock = 19; Kill = 20; Plugin = 21;
}

enum Weather: i32 { Clear = 0; Rain = 1; Thunder = 2; }

enum FormKind: i32 { Message = 0; Menu = 1; Custom = 2; }

enum FormElement: i32 { Label = 0; Toggle = 1; Slider = 2; StepSlider = 3; Dropdown = 4; Input = 5; Header = 6; Divider = 7; }

enum LogLevel: i32 { Debug = 0; Info = 1; Warn = 2; Error = 3; }

enum MeshAnchor: i32 @doc("Where an entity mesh is attached and what it turns with") {
    Body = 0 @doc("origin at the feet, turns with the body");
    Head = 1 @doc("origin at the eyes, turns with the head (yaw and pitch)");
    Feet = 2 @doc("origin at the feet, never turns: world axes");
}

flags ViewModelField: u32 @doc("Which values of ViewModelData are applied; the rest stay as the player set them") {
    SwingSpeed = 0; Scale = 1; Bob = 2; Arm = 3; Item = 4; Visible = 5; Sway = 6; Equip = 7; LeftHanded = 8;
}
alias ViewModelFields = flagset<ViewModelField>;

enum SocketKind: i32 { Tcp = 0; WebSocket = 1; }

enum AudioCategory: i32 @doc("Which volume slider scales a stream") {
    Master = 0; Music = 1; Record = 2; Weather = 3; Block = 4; Hostile = 5; Neutral = 6; Player = 7; Ambient = 8; Voice = 9;
}

enum SlotCorner: i32 { TopLeft = 0; TopRight = 1; BottomLeft = 2; BottomRight = 3; Center = 4; }

flags WindowField: u32 @doc("Which values of WindowControlData are applied") {
    Fullscreen = 0; Title = 1;
}
alias WindowFields = flagset<WindowField>;
